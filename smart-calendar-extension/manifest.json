{
  "manifest_version": 3,
  "name": "Smart Calendar — AI Productivity",
  "version": "1.0.0",
  "description": "Today's AI-scheduled tasks, deadline alerts, and focus reminders from Smart Calendar.",

  "permissions": [
    "storage",
    "notifications",
    "alarms",
    "tabs",
    "scripting"
  ],

  "host_permissions": [
    "http://localhost:3000/*",
    "http://localhost:3001/*",
    "https://*.blackboard.com/*",
    "http://*.blackboard.com/*"
  ],

  "background": {
    "service_worker": "src/background.js"
  },

  "action": {
    "default_popup": "src/popup.html",
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_badge_text": ""
  },

  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "content_scripts": [
    {
      "matches": [
        "http://localhost:3000/*",
        "https://*.blackboard.com/*",
        "http://*.blackboard.com/*"
      ],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    }
  ]
}
