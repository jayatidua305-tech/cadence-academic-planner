# Cadence — Environment Variables
# Copy this file to `.env` (or `.env.local`) and fill in your credentials.
# NEVER commit the real .env — it is gitignored.

# ──────────────────────────────────────────────────────────────────────────
# Google OAuth — for Google Calendar sync
# Create at: https://console.cloud.google.com/apis/credentials
# See SETUP_GOOGLE_CALENDAR.md for the full walkthrough.
# ──────────────────────────────────────────────────────────────────────────
REACT_APP_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE

# Optional: Google API key for public calendar reads
REACT_APP_GOOGLE_API_KEY=YOUR_GOOGLE_API_KEY_HERE

# ──────────────────────────────────────────────────────────────────────────
# AI providers — pick ONE or both
# The app prefers Groq for speed; falls back to Anthropic if configured.
# ──────────────────────────────────────────────────────────────────────────

# Groq (console.groq.com) — Llama 3.3 70B Versatile
REACT_APP_GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE

# Anthropic (console.anthropic.com) — Claude Sonnet / Opus
REACT_APP_ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY_HERE

# ──────────────────────────────────────────────────────────────────────────
# Twilio — optional, used by the WhatsApp reminder service in /server
# Create at: https://console.twilio.com
# ──────────────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=YOUR_TWILIO_SID_HERE
TWILIO_AUTH_TOKEN=YOUR_TWILIO_TOKEN_HERE
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
